#!/usr/bin/env bash
# lab - HOST-side wrapper (run on dockerhost from ~/infiniband-lab).
# Usage: lab up | shell | down      up = build image + (re)create container; shell = open a prompt
# inside it with the simulator environment loaded.
set -euo pipefail
cd "$(dirname "$0")/.."
case "${1:-shell}" in
  up)    docker build -q -t ib-lab . >/dev/null
         docker rm -f ib-lab >/dev/null 2>&1 || true
         docker run -d --init --name ib-lab --restart unless-stopped -v "$PWD:/lab" ib-lab >/dev/null
         docker exec ib-lab bash -c 'echo "source /lab/scripts/env.sh" >> /root/.bashrc; echo "export PATH=/lab/scripts:\$PATH" >> /root/.bashrc'
         echo "container ib-lab up. Next: lab shell, then reset-lab.sh" ;;
  shell) exec docker exec -it ib-lab bash ;;
  down)  docker rm -f ib-lab ;;
  *)     echo "usage: lab up|shell|down" >&2; exit 2 ;;
esac
